<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FitnessPlanner.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FitnessPlanner.App"
    xmlns:views="clr-namespace:FitnessPlanner.App.Views"
    Title="FitnessPlanner.App">

    <TabBar>

        <ShellContent
            Title="Home"
            Route="dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}" />

        <ShellContent
            Title="Planner"
            Route="planner"
            ContentTemplate="{DataTemplate views:PlannerPage}" />

        <ShellContent
            Title="Diary"
            Route="diary"
            ContentTemplate="{DataTemplate views:DiaryPage}" />

        <ShellContent
            Title="Pet"
            Route="pet"
            ContentTemplate="{DataTemplate views:PetPage}" />


    </TabBar>

    

</Shell>
