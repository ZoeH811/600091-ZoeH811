<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessPlanner.App.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!--Dashboard Header-->
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Fitness Planner"
                    FontSize="28"
                    FontAttributes="Bold" />

                <Label
                    Text="Your personal fitness journey"
                    FontSize="14"
                    TextColor="Gray" />
                
            </VerticalStackLayout>

            <!--Pet Section-->
            <Border
                Stroke="#D0D0D0"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Your adventure companion"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="Pet Preview"
                        FontSize="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HeightRequest="100" />

                    <Label
                        Text="Level 1 - 0/100 XP"
                        FontSize="14" />

                    <ProgressBar
                        Progress="0"
                        ProgressColor="Green" />
                </VerticalStackLayout>
                
            </Border>

            <!--Todays Workout-->
            <Border
                Stroke="#D0D0D0"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="20">

                    <Label
                        Text="Todays Workout"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="No Workouts Scheduled"
                        FontSize="14" />

                    <Button
                        Text="Start Workout"
                        Clicked="OnStartWorkoutClicked" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
