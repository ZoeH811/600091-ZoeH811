<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FitnessPlanner.App.Views.PlannerPage"
    Title="Workout Planner">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                Text="Workout Planner"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Organise and manage your workouts."
                FontSize="16"
                TextColor="Gray" />

            <Border
                Stroke="#D0D0D0"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Your Workout Plans"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="No workout plans created yet."
                        FontSize="14" />

                    <Button
                        Text="Create Workout Plan" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
