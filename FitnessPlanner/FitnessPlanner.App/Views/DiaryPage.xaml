<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FitnessPlanner.App.Views.DiaryPage"
    Title="Activity Diary">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                Text="Activity Diary"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Record and review your completed activities."
                FontSize="16"
                TextColor="Gray" />

            <Border
                Stroke="#D0D0D0"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Your Activities"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="No activities recorded yet." />

                    <Button
                        Text="Record Activity" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
