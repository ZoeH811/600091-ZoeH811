<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FitnessPlanner.App.Views.DiaryPage"
    Title="Activity Diary">


    <Grid Padding="20"
      RowDefinitions="Auto,Auto,*"
      RowSpacing="15">

        <Label
        Grid.Row="0"
        Text="Activity Diary"
        FontSize="28"
        FontAttributes="Bold" />

        <Button
        Grid.Row="1"
        Text="Add Test Activity"
        Command="{Binding AddTestActivityCommand}" />

        <CollectionView
        Grid.Row="2"
        ItemsSource="{Binding Activities}">

            <CollectionView.EmptyView>
                <Label
                Text="No activities recorded yet."
                HorizontalOptions="Center"
                Margin="0,30" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                    Stroke="#D0D0D0"
                    StrokeThickness="1"
                    Padding="15"
                    Margin="0,5">

                        <VerticalStackLayout Spacing="5">

                            <Label
                            Text="{Binding Name}"
                            FontSize="18"
                            FontAttributes="Bold" />

                            <Label
                            Text="{Binding ActivityType}"
                            FontSize="14" />

                            <Label
                            Text="{Binding DurationMinutes,
                                   StringFormat='Duration: {0} minutes'}"
                            FontSize="14" />

                            <Label
                            Text="{Binding Date,
                                   StringFormat='Date: {0:dd MMM yyyy}'}"
                            FontSize="12" />

                        </VerticalStackLayout>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>


</ContentPage>
